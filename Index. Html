<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pixel Tools - Free Image Resizer</title>
<meta name="description" content="Free online image resizer. Resize photos by width and height right in your browser. No upload, no signup.">
<style>
  * { box-sizing: border-box; }
  body { font-family: Arial, sans-serif; background: #f3f4f8; margin: 0; padding: 20px; color: #222; }
  .box { max-width: 520px; margin: 0 auto; background: #fff; padding: 24px; border-radius: 14px; box-shadow: 0 4px 16px rgba(0,0,0,.08); }
  h1 { margin-top: 0; color: #4f46e5; font-size: 24px; }
  label { display: block; margin: 14px 0 6px; font-weight: bold; font-size: 14px; }
  input[type=number], input[type=file], select { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 8px; font-size: 15px; }
  .row { display: flex; gap: 10px; }
  .row > div { flex: 1; }
  button { width: 100%; margin-top: 18px; padding: 12px; background: #4f46e5; color: #fff; border: 0; border-radius: 8px; font-size: 16px; cursor: pointer; }
  button:disabled { background: #aaa; }
  #preview { max-width: 100%; margin-top: 18px; border-radius: 8px; display: none; }
  #download { display: none; text-align: center; margin-top: 14px; padding: 12px; background: #16a34a; color: #fff; border-radius: 8px; text-decoration: none; }
  .info { font-size: 13px; color: #666; margin-top: 8px; }
</style>
</head>
<body>
<div class="box">
  <h1>Pixel Tools - Image Resizer</h1>
  <p class="info">Your photo never leaves your device. Everything happens in your browser.</p>

  <label>Choose an image</label>
  <input type="file" id="file" accept="image/*">

  <div class="row">
    <div><label>Width (px)</label><input type="number" id="w" min="1"></div>
    <div><label>Height (px)</label><input type="number" id="h" min="1"></div>
  </div>

  <label><input type="checkbox" id="lock" checked> Keep aspect ratio</label>

  <label>Output format</label>
  <select id="fmt">
    <option value="image/jpeg">JPG</option>
    <option value="image/png">PNG</option>
    <option value="image/webp">WEBP</option>
  </select>

  <button id="go" disabled>Resize Image</button>
  <img id="preview" alt="Preview">
  <a id="download">Download Resized Image</a>
</div>

<script>
  const file = document.getElementById('file');
  const w = document.getElementById('w');
  const h = document.getElementById('h');
  const lock = document.getElementById('lock');
  const fmt = document.getElementById('fmt');
  const go = document.getElementById('go');
  const preview = document.getElementById('preview');
  const download = document.getElementById('download');
  let img = new Image();
  let ratio = 1;

  file.addEventListener('change', () => {
    const f = file.files[0];
    if (!f) return;
    img = new Image();
    img.onload = () => {
      w.value = img.width;
      h.value = img.height;
      ratio = img.width / img.height;
      go.disabled = false;
    };
    img.src = URL.createObjectURL(f);
  });

  w.addEventListener('input', () => {
    if (lock.checked && w.value) h.value = Math.round(w.value / ratio);
  });
  h.addEventListener('input', () => {
    if (lock.checked && h.value) w.value = Math.round(h.value * ratio);
  });

  go.addEventListener('click', () => {
    const c = document.createElement('canvas');
    c.width = parseInt(w.value);
    c.height = parseInt(h.value);
    const ctx = c.getContext('2d');
    if (fmt.value === 'image/jpeg') { ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, c.width, c.height); }
    ctx.drawImage(img, 0, 0, c.width, c.height);
    const url = c.toDataURL(fmt.value, 0.92);
    preview.src = url;
    preview.style.display = 'block';
    const ext = fmt.value.split('/')[1].replace('jpeg', 'jpg');
    download.href = url;
    download.download = 'resized.' + ext;
    download.style.display = 'block';
  });
</script>
</body>
</html>
